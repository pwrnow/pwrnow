# Environment Configuration for Google OAuth Authentication
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pwrnow

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_LIFETIME=15  # minutes
JWT_REFRESH_TOKEN_LIFETIME=7  # days

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Site Configuration
SITE_URL=http://localhost:8000

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# Security Settings (Production)
DJANGO_SECURE_SSL_REDIRECT=False  # Set to True in production with HTTPS
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False  # Set to True in production
DJANGO_SECURE_HSTS_PRELOAD=False  # Set to True in production

# Notification Settings
DISCORD_WEBHOOK_URL=your-discord-webhook-url
SUPPRESS_NOTIFICATIONS=False
SUPPRESS_DISCORD_NOTIFICATIONS=False