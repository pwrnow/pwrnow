# PWr Now Mobile App - Environment Variables Example
# Copy this file to .env.local and fill in your own values

# API Configuration
EXPO_PUBLIC_API_URL=https://api.pwrnow.pl
EXPO_PUBLIC_SITE_URL=https://pwrnow.pl

# PostHog Analytics (optional)
# Get these from https://posthog.com
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Google OAuth (optional)
# Get these from Google Cloud Console
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Sentry Error Tracking (optional but recommended)
# Get this from https://sentry.io
# Format: https://[key]@[organization].ingest.sentry.io/[project-id]
EXPO_PUBLIC_SENTRY_DSN=

# Note: .env.local is gitignored and won't be committed to the repository
# See mobile/SENTRY_SETUP.md for more information about setting up Sentry
