{
  "expo": {
    "name": "PWr Now",
    "slug": "pwrnow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "primaryColor": "#000000",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "backgroundColor": "#000000",
      "supportsTablet": false,
      "bundleIdentifier": "pl.pwrnow.app",
      "associatedDomains": ["applinks:pwrnow.pl"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["pl", "en"],
        "CFBundleDevelopmentRegion": "pl"
      },
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png"
      },
      "splash": {
        "backgroundColor": "#ffffff",
        "dark": {
          "backgroundColor": "#000000"
        }
      }
    },
    "android": {
      "package": "pl.pwrnow.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pwrnow.pl",
              "pathPrefix": "/wydarzenia"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Righteous-Regular.ttf",
            "./assets/fonts/SpaceGrotesk-Light.ttf",
            "./assets/fonts/SpaceGrotesk-Regular.ttf",
            "./assets/fonts/SpaceGrotesk-Medium.ttf",
            "./assets/fonts/SpaceGrotesk-SemiBold.ttf",
            "./assets/fonts/SpaceGrotesk-Bold.ttf"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Aplikacja potrzebuje dostępu do kalendarza, aby dodać wydarzenie."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "pl"],
            "android": ["en", "pl"]
          }
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "pwrnow",
    "extra": {
      "router": {
        "origin": "https://pwrnow.pl"
      },
      "eas": {
        "projectId": "28be113a-2b1b-4840-8cdb-47c7faea0694"
      }
    },
    "owner": "pwrnow",
    "experiments": {
      "buildCacheProvider": "eas"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/28be113a-2b1b-4840-8cdb-47c7faea0694"
    }
  }
}
